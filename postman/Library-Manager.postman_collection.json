{
  "info":{"name":"Library Manager Final API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:3000"},{"key":"token","value":""}],
  "item":[
    {"name":"Health","request":{"method":"GET","url":"{{baseUrl}}/api/health"}},
    {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"student@library.local\",\"password\":\"Password@123\"}"},"url":"{{baseUrl}}/api/auth/login"}},
    {"name":"Books","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/books?page=1&limit=20&sort=title"}},
    {"name":"Borrow","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"bookId\":1}"},"url":"{{baseUrl}}/api/loans/borrow"}},
    {"name":"My Loans","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/loans/my"}}
  ]
}
